# ── 私钥 / 证书（绝对不能提交）──────────────────────────────
*.pem
*.key
*.p12
*.pfx

# ── 环境变量（含敏感配置，不能提交）────────────────────────
.env
.env.local
.env.*.local
# .env.example 可以提交（模板文件，不含真实值）

# ── Maven 构建产物 ───────────────────────────────────────
**/target/

# ── Node.js / 前端构建产物 ───────────────────────────────
**/node_modules/
**/dist/

# ── IDE 配置 ─────────────────────────────────────────────
.idea/
*.iml
.vscode/
*.swp
*.swo

# ── macOS 系统文件 ───────────────────────────────────────
.DS_Store
**/.DS_Store
