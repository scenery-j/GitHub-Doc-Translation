# 排除编译产物目录（Docker 构建时会在容器内重新编译）
target/

# 排除 IDE 配置文件（与构建无关）
.idea/
*.iml
.vscode/

# 排除 git 相关文件
.git/
.gitignore

# 排除本地开发用的 .env 文件（敏感信息不能打进镜像）
# 生产环境通过 docker-compose 的 environment 或 secrets 注入
.env
.env.*

# 排除私钥文件（通过 docker-compose volume 挂载注入，绝不能打进镜像）
*.pem
src/main/resources/pem/

# 排除 README 和文档
README.md
docs/

# 排除 macOS 系统文件
.DS_Store
