# =============================================================
# 环境变量配置模板
# 使用方式：cp .env.example .env，然后填写真实值
# !! 警告：.env 文件包含敏感信息，绝对不能提交到 Git !!
# =============================================================

# ── 数据库配置 ─────────────────────────────────────────────────
DATABASE_NAME=doc_translation
DATABASE_USERNAME=your_db_user
DATABASE_PASSWORD=your_strong_db_password

# ── GitHub App 配置 ────────────────────────────────────────────
# 在 https://github.com/settings/apps 创建 App 后获取
GITHUB_APP_ID=123456
GITHUB_APP_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_APP_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_APP_WEBHOOK_SECRET=your_webhook_secret
# GitHub App 的 slug（URL 中显示的短名称）
GITHUB_APP_SLUG=doc-translation-github-app

# ── AI 翻译配置 ────────────────────────────────────────────────
# 在 https://openrouter.ai/keys 获取
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 应用安全配置 ───────────────────────────────────────────────
# JWT_SECRET：用于签发/验证 JWT，至少 32 位随机字符串
# 生成命令：openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-char-string-please-do-not-use-this

# ENCRYPTION_KEY：用于加密存储在数据库中的 API Key，必须正好 32 字符
# 生成命令：openssl rand -hex 16
ENCRYPTION_KEY=change-me-32-char

# ── 前端访问地址 ───────────────────────────────────────────────
# GitHub OAuth 登录成功后重定向的地址
# 本地：http://localhost
# 生产：https://yourdomain.com
FRONTEND_URL=http://localhost
